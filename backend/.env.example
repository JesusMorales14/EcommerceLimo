# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del backend. Copia este archivo como `.env`.
# Se validan al arrancar (src/config/env.validation.ts): si falta una
# obligatoria, la API no inicia.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: development | production | test
NODE_ENV=development
PORT=3000

# [Obligatorio] Cadena de conexión PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# [Obligatorio] Mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS, separados por comas (admite comodín: https://*.vercel.app)
CORS_ORIGINS=http://localhost:4200
# URL pública del frontend (enlaces en correos y sitemap)
FRONTEND_URL=http://localhost:4200

# Stripe (opcional: sin clave, el pago con tarjeta queda deshabilitado)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo SMTP (opcional: sin credenciales, no se envían correos)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Destinatario de las notificaciones de nuevos reclamos
ADMIN_EMAIL=

# Seed de datos de demostración (npm run seed). Obligatorias en producción.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
