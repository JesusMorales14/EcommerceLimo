{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage ng test",
    "lint": "eslint \"src/**/*.{ts,html}\" \"e2e/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" \"e2e/**/*.ts\" --fix",
    "e2e": "playwright test",
    "e2e:functional": "playwright test e2e/functional",
    "e2e:non-functional": "playwright test e2e/non-functional",
    "e2e:report": "playwright show-report playwright-report"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.20",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.60.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.3": true
  }
}
